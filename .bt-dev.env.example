# ============================================================================
#  .bt-dev.env.example — dev.sh 的配置模板（复制为 .bt-dev.env 后按需修改）
#
#  用法：
#       cp .bt-dev.env.example .bt-dev.env
#       ./scripts/dev.sh
#  启动只需一条命令，其余全部在 .bt-dev.env 里配置。
#  所有变量均可用环境变量覆盖，配置文件里的值优先于脚本默认值。
#
#  @author pony
#  @date 2026-08-24
#  @version v1.0.0
#  @last_modified 2026-08-24
#  @changelog
#    - v1.0.0 (2026-08-24): 初始模板
# ============================================================================

# ---- 端口与监听 -----------------------------------------------------------
# bt_server 后端（编辑器 /api 代理到它）
BT_SERVER_HOST=127.0.0.1
BT_SERVER_PORT=8080

# Vite 前端
BT_EDITOR_HOST=127.0.0.1
BT_EDITOR_PORT=5173

# ---- 构建目录与 server 二进制 --------------------------------------------
BT_BUILD_DIR=build
# BT_SERVER_BIN=build/bin/bt_server   # 默认 `${BT_BUILD_DIR}/bin/bt_server`

# ---- 节点插件 --------------------------------------------------------------
# bt_nodes 插件路径（默认自动探测 build/lib/libbt_nodes.so）
# BT_NODES_PLUGIN=build/lib/libbt_nodes.so

# ROS2 适配节点插件（默认在检测到 ROS2 时自动构建并加载 build/lib/libbt_ros2_plugin.so）
# BT_ROS2_PLUGIN=build/lib/libbt_ros2_plugin.so

# 自研插件目录：放置所有 *.so，bt_server 会自动扫描加载（如你自研的 Yuyi 插件）。
# BT_PLUGIN_DIR=/path/to/yuyi/plugin/libs

# ---- ROS2 环境（检测到 ROS2 时自动构建 bt_ros2_plugin）----------------------
# 固定某个 distro 的 setup；不设时自动探测 /opt/ros/humble。
# BT_ROS_SETUP_FILE=/opt/ros/humble/setup.bash
# 仓库内 ROS2 overlay 安装的 setup；「off」或「none」可关闭。
# BT_ROS_OVERLAY_FILE=off

# ---- ROS2 只读图 bridge（编辑器「ROS2 运行时能力」面板数据源）----------------
# auto 自动托管；on 强制（失败即返回错误）；off 关闭。
BT_ROS_WEB_MODE=auto
BT_ROS_WEB_HOST=127.0.0.1
BT_ROS_WEB_PORT=8088
# BT_ROS_WEB_LOG_FILE=/tmp/bt_ros_web.log
